# Copia este archivo como .env únicamente en el entorno privado.
# Nunca reemplaces estos marcadores con valores reales dentro del repositorio.

# Cámaras Bosch / Raspberry
CAMERA_HOST=<CAMERA_HOST_OR_IP>
CAMERA_USERNAME=<CAMERA_USERNAME>
CAMERA_PASSWORD=<CAMERA_PASSWORD>
MILESIGHT_SERIAL_PORT=<SERIAL_PORT>
DRAGINO_SERIAL_PORT=<SERIAL_PORT>
MILESIGHT_BAUDRATE=9600

# Gateway LoRaWAN
GATEWAY_BASE_URL=<GATEWAY_BASE_URL>
GATEWAY_USERNAME=<GATEWAY_USERNAME>
GATEWAY_PASSWORD=<GATEWAY_PASSWORD>

# MySQL
DB_URL=<DATABASE_JDBC_URL>
DB_USER=<DATABASE_USERNAME>
DB_PASSWORD=<DATABASE_PASSWORD>

# Activación LoRaWAN por dispositivo
LORAWAN_DEV_EUI=<DEVICE_DEV_EUI>
LORAWAN_JOIN_EUI=<APPLICATION_OR_JOIN_EUI>
LORAWAN_APP_KEY=<LORAWAN_APP_KEY>

# Grafana
GRAFANA_DATASOURCE_UID=<GRAFANA_DATASOURCE_UID>

